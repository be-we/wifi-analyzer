#: src/wifi_analyzer/app.py:123
msgid "Unavailable in the detected regulatory domain"
msgstr "Im erkannten Regulierungsbereich nicht vorhanden"

#: src/wifi_analyzer/app.py:125
msgid "DFS — radar detection may interrupt this channel"
msgstr "DFS – Radarerkennung kann diesen Kanal unterbrechen"

#: src/wifi_analyzer/app.py:127
msgid "DFS — availability depends on local regulations"
msgstr "DFS – Verfügbarkeit hängt von den örtlichen Regulierungen ab"

#: src/wifi_analyzer/app.py:200 src/wifi_analyzer/app.py:342
msgid "No Wi-Fi device found"
msgstr "Kein WLAN-Gerät gefunden"

#: src/wifi_analyzer/app.py:201
msgid ""
"Enable Wi-Fi in system settings, disable airplane mode, and check the "
"adapter driver."
msgstr ""
"Aktiviere WLAN in den Systemeinstellungen, deaktiviere den Flugmodus und "
"überprüfe den Adaptertreiber."

#: src/wifi_analyzer/app.py:204
msgid "Wi-Fi signal is weak"
msgstr "WLAN-Signal ist schwach"

#: src/wifi_analyzer/app.py:205
msgid ""
"Move closer to the access point, reduce obstructions, or select a less "
"congested channel."
msgstr ""
"Gehe näher an den Zugangspunkt heran, beseitige Hindernisse oder wähle "
"einen weniger ausgelasteten Kanal aus."

#: src/wifi_analyzer/app.py:208
msgid "Wi-Fi connection was lost"
msgstr "WLAN-Verbindung wurde unterbrochen"

#: src/wifi_analyzer/app.py:209
msgid ""
"Check the access point, reconnect from system settings, and inspect the "
"gateway and DNS diagnostics."
msgstr ""
"Überprüfe den Zugangspunkt, stelle die Verbindung über die "
"Systemeinstellungen erneut her und untersuche die Gateway- und DNS-"
"Diagnosen."

#: src/wifi_analyzer/app.py:211
msgid "Wi-Fi access point changed"
msgstr "WLAN-Zugangspunkt geändert"

#: src/wifi_analyzer/app.py:212
msgid ""
"Roaming can be normal. If it causes interruptions, compare signal history "
"and access-point overlap."
msgstr ""
"Roaming kann ganz normal sein. Sollte es zu Unterbrechungen kommen, "
"vergleiche den Signalverlauf und die Überlappung der Zugangspunkte."

#: src/wifi_analyzer/app.py:340
msgid "Error: no WiFi device found"
msgstr "Fehler: kein WLAN-Gerät gefunden"

#: src/wifi_analyzer/app.py:380 src/wifi_analyzer/app.py:858
msgid "<Hidden>"
msgstr "<Versteckt>"

#: src/wifi_analyzer/app.py:459
msgid "No networks found"
msgstr "Keine Netzwerke gefunden"

#: src/wifi_analyzer/app.py:588
msgid "measured"
msgstr "gemessen"

#: src/wifi_analyzer/app.py:588
msgid "estimated"
msgstr "geschätzt"

#: src/wifi_analyzer/app.py:592
#, python-brace-format
msgid " · seen {seconds}s ago"
msgstr " · vor {seconds}s gesehen"

#: src/wifi_analyzer/app.py:593
msgid " · Connected"
msgstr " · Verbunden"

#: src/wifi_analyzer/app.py:594
#, python-brace-format
